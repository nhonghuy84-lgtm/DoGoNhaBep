<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="24dp"
    android:background="#FFFFFF">

    <!-- Logo Công ty -->
    <ImageView
        android:id="@+id/imgCompanyLogo"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/ic_store_logo"
        android:contentDescription="Logo"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="HỒNG SƠN TRADING PRODUCTION CO., LTD"
        android:textColor="#333333"
        android:textSize="14sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <TextView
        android:id="@+id/tvSummary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Số lượng sản phẩm: 7\nTổng giá trị đơn hàng MOQ: $23,730 USD"
        android:textColor="#666666"
        android:textSize="13sp"
        android:gravity="center"
        android:layout_marginBottom="32dp" />

    <!-- Nút 1: DANH SÁCH SẢN PHẨM -->
    <Button
        android:id="@+id/btnProductList"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="DANH SÁCH SẢN PHẨM"
        android:textColor="#333333"
        android:backgroundTint="#E0E0E0"
        android:layout_marginBottom="12dp" />

    <!-- Nút 2: THÊM SẢN PHẨM -->
    <Button
        android:id="@+id/btnAddProduct"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="THÊM SẢN PHẨM"
        android:textColor="#333333"
        android:backgroundTint="#E0E0E0"
        android:layout_marginBottom="12dp" />

    <!-- Nút 3: ĐĂNG NHẬP / THOÁT -->
    <Button
        android:id="@+id/btnLogout"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="THOÁT / ĐĂNG NHẬP"
        android:textColor="#FFFFFF"
        android:backgroundTint="#E53935" />

</LinearLayout>